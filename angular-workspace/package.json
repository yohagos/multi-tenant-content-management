{
  "name": "angular-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "watch:shared-ui": "ng build shared-ui --watch",
    "watch:shared-data": "ng build shared-data-access --watch",
    "watch:shared-utils": "ng build shared-utils --watch",
    "build:libs": "ng build shared-data-access && ng build shared-ui && ng build shared-utils",
    "build:shell": "ng build shell --configuration=production",
    "build:tenant-admin": "ng build tenant-admin --configuration=production",
    "build:content-editor": "ng build content-editor --configuration=production",
    "build:public-view": "ng build public-view --configuration=production",
    "build:all": "npm run build:shell && npm run build:tenant-admin && npm run build:content-editor && npm run build:public-view"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@softarc/native-federation-node": "^3.3.4",
    "es-module-shims": "^1.5.12",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^22.2.5",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.3.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  }
}
